<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/reset.css" />
    <link rel="stylesheet" href="~/css/widget.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link href="~/lib/gijgo/combined/css/gijgo.min.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="body_content">
    <header id="header">
        <nav class="navbar navbar-expand-md navbar-toggleable-md navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid w-100 m-0 p-0">
                <div class="logo">
                    <div class="logo_bg">
                        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                            <img src="~/images/web/logo_new.png" alt="Логотип ТФ ОМС РИ" title="Логотип ТФ ОМС РИ" />
                            <span>
                                ТЕРРИТОРИАЛЬНЫЙ ФОНД<br /> ОБЯЗАТЕЛЬНОГО МЕДИЦИНСКОГО<br /> СТРАХОВАНИЯ РЕСПУБЛИКИ ИНГУШЕТИЯ
                            </span>
                        </a>
                    </div>
                </div>
            </div>
            <div class="container-fluid w-100 m-0 bg-primary-gradient">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-md-inline-flex justify-content-between">
                    <partial name="_TopMenu" />
                    <partial name="_LoginMenu" />
                </div>
            </div>
        </nav>
    </header>

    <main>
        <div class="container-fluid m-0 p-0 mt-4">
            <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-4 col-lg-3 col-xl-3 col-xxl-2 p-0 py-2">
                    <!-- ASIDE MENU -->
                    <partial name="_AsideMenu" />
                    <!-- END ASIDE MENU -->
                </div>
                <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xl-6 col-xxl-7 p-0 py-2">
                    @RenderBody()
                </div>
                <div class="col-xs-12 col-sm-12 col-md-8 offset-md-4 col-lg-3 offset-lg-0 col-xl-3 col-xxl-3 p-0 py-2">
                    <!--ASIDE WIDGET ФФОМС-->
                    <partial name="_AsideWidget" />
                    <!--END ASIDE WIDGET ФФОМС-->
                </div>
            </div>
        </div>
    </main>


    <footer id="footer" class="text-center pb-2">
        <hr />
        <p><strong>&copy; @DateTime.Now.Year - ТФ ОМС РИ. Все права защищены.</strong></p>
    </footer>

    <script src="https://pos.gosuslugi.ru/bin/script.min.js"></script>
    <script>Widget("https://pos.gosuslugi.ru/form", 354207)</script>
    <script src="~/js/widget.js" asp-append-version="true"></script>

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/gijgo/combined/js/gijgo.min.js" type="text/javascript"></script>
    <script src="~/lib/gijgo/combined/js/messages/messages.ru-ru.min.js" type="text/javascript"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @{
        if (ViewContext.HttpContext.Request.Path.Value.Contains("servis-dlya-proverki-aktualnosti-polis"))
        {
            <script type="text/javascript">
                let length = document.getElementsByClassName("rounded-start-3").length;
                for (var i = 1; i <= length; i++) {
                    $(`#datepicker${i}`).datepicker({
                        uiLibrary: 'bootstrap5',
                        format: 'dd.mm.yyyy',
                        locale: 'ru-ru',
                        autclose: true,
                        todayHighlight: true
                    });
                }
            </script>
        }
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
