<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="~/lib/summernote/popper.min.js"></script>

    <link href="~/lib/summernote/bootstrap.css" rel="stylesheet">
    <script src="~/lib/summernote/jquery-3.5.1.js"></script>

    @*<script src="~/lib/summernote/bootstrap.js"></script>*@
    <script src="~/lib/summernote/bootstrap.bundle.js"></script>

    <link href="~/lib/summernote/summernote-bs4.css" rel="stylesheet">
    <script src="~/lib/summernote/summernote-bs4.js"></script>

    <script src="~/lib/summernote/lang/summernote-ru-RU.js"></script>
    <script src="~/lib/summernote/summernote-file.js"></script>
    <script src="~/lib/summernote/summernote-image-attributes.js"></script>
    <link href="~/lib/gijgo/combined/css/gijgo.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/reset.css" rel="stylesheet">
    <link href="~/css/admin.css" rel="stylesheet">
</head>
<body>

    <header id="header">
        <nav class="navbar navbar-expand-md navbar-toggleable-md navbar-light bg-primary-gradient border-bottom box-shadow">
            <div class="container-fluid w-100 m-0 p-0">
                <div class="logo">
                    <div class="logo_admin">
                        <a href="/"></a>
                    </div>
                    <div id="currentDateTime">
                        <div id="currentDate">
                            <img src="~/images/web/calendar.png" />
                        </div>
                        <div id="currentTime">
                        </div>
                    </div>
                </div>                   
            </div>

            <div class="container-fluid w-100 m-0 p-0">
                <button class="navbar-toggler" type="button" data-target=".navbar-collapse" data-toggle="collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-md-inline-flex justify-content-between">
                    <partial name="_TopAdminMenu" />
                    <partial name="_LoginMenu" />
                </div>
            </div>
        </nav>
    </header>

    <main>
        <div class="container-fluid mt-4">
            @RenderBody()
        </div>
    </main>

    @*<footer id="footer" class="text-center pb-2">
            <hr />
            <p><strong>&copy; @DateTime.Now.Year - ТФ ОМС РИ. Все права защищены.</strong></p>
        </footer>*@
    <script src="~/lib/gijgo/combined/js/gijgo.min.js" type="text/javascript"></script>
    <script src="~/lib/gijgo/combined/js/messages/messages.ru-ru.min.js" type="text/javascript"></script>
    <script src="~/js/admin.js"></script>

    <script type="text/javascript">
        
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
