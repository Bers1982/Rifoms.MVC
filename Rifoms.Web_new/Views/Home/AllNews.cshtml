@model AllNewsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.NewsTitle;
}
@{
    <style>
        .allnews > nav {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: flex-end;
        }

            .allnews > nav * {
                font-size: 1.6rem;
            }

            .allnews > nav > ul {
                margin: 0 0 0 10px;
            }

                .allnews > nav > ul > li {
                    padding: 0 5px 0 5px;
                }
    </style>

    <h1 class="font">@Model.NewsTitle</h1>
    <div class="allnews">
        @{
            if (Model.AllNews?.Count > 0)
            {
                foreach (var item in Model.AllNews)
                {
                    <div class="header_text d-flex flex-row flex-nowrap justify-content-between align-content-start">
                        <h2 class="mb-3 fw-bolder text-wrap">
                            <a class="font text-decoration-none" href="@($"{Model.SiteUrl}/{item.Id}/{item.Seolink}.html")">
                                @item.Title
                            </a>
                        </h2>
                        <h4 class="text-nowrap mt-2">@item.Pubdate.ToString("D")</h4>
                    </div>
                    <div class="d-inline-block paragraf-text">
                        @(Html.Raw(item.Description))
                    </div>
                    <hr />
                }
            }
        }
        @{
            var AllNewsSeolink = Model.AllNews.Any(c => c.CategoryId == 8) ? "novosti-tfoms-ri" : "regionalnye-novosti";

            <nav aria-label="AllNewsPagination">
                <span>Страницы :</span>
                <ul class="pagination">
                    @{
                        int FirstPageIndex = 0;
                        int NextPageIndex=0;
                        int step = Model.PageView.TotalPages - Model.PageView.PageNumber;

                        if (Model.PageView.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@($"{Model.SiteUrl}/novosti/{AllNewsSeolink}.html")" aria-label="Previous"
                                   data-bs-toggle="tooltip" data-bs-placement="top"
                                   title="Первая">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>
                        }

                        if (step >= 4)
                        {
                            for (int i = 1; i <= 4; i++)
                            {
                                bool isActive = Model.PageView.TotalPages - step == Model.PageView.PageNumber;
                                if (isActive)
                                {
                                    FirstPageIndex = step;
                                    if (Model.PageView.PageNumber - 1 > 1 && FirstPageIndex == 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@($"{Model.SiteUrl}/novosti/{AllNewsSeolink}/page-{Model.PageView.PageNumber-1}.html")" aria-label="Previous"
                                               data-bs-toggle="tooltip" data-bs-placement="top"
                                               title="Предыдущая">
                                                <span aria-hidden="true">&laquo;</span>
                                            </a>
                                        </li>
                                    }
                                }
                                <li class="page-item @(isActive ? "active" : string.Empty)">
                                    <a class="page-link" href="@($"{Model.SiteUrl}/novosti/{AllNewsSeolink}/page-{Model.PageView.TotalPages - step}.html")">
                                        @(Model.PageView.TotalPages - step)
                                    </a>
                                </li>
                                step = step - 1;
                            }
                        }
                        else
                        {
                            for (int i = 4; i >= 1; i--)
                            {
                                bool isActive = Model.PageView.TotalPages - i == Model.PageView.PageNumber;
                                if (isActive)
                                    FirstPageIndex = i;
                                <li class="page-item @(isActive ? "active" : string.Empty)">
                                    <a class="page-link" href="@($"{Model.SiteUrl}/novosti/{AllNewsSeolink}/page-{Model.PageView.TotalPages - i}.html")">
                                        @(Model.PageView.TotalPages - i)
                                    </a>
                                </li>
                            }
                            if (Model.PageView.PageNumber - 1 > 1 && FirstPageIndex == 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@($"{Model.SiteUrl}/novosti/{AllNewsSeolink}/page-{Model.PageView.PageNumber-1}.html")" aria-label="Previous"
                                       data-bs-toggle="tooltip" data-bs-placement="top"
                                       title="Предыдущая">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                            }
                        }

                        if (Model.PageView.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@($"{Model.SiteUrl}/novosti/{AllNewsSeolink}/page-{Model.PageView.TotalPages}.html")" aria-label="Previous"
                                   data-bs-toggle="tooltip" data-bs-placement="top"
                                   title="Последняя">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                        }
                    }
                </ul>
            </nav>
        }
    </div>
}