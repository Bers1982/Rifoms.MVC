@model BaseModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Админ-панель ТФОМС РИ";
}
@{
    <style>
        .admin-footer > *,
        .admin-footer > * > *,
        .admin_header > * {
            font-size: 16px;
            margin: 3px 0 3px 0;
        }

        .admin_header {
            font-weight: bold;
        }

        .admin-footer,
        .admin_header {
            margin: 0 30px 0 30px;
            padding: 5px 0 5px 0;
        }
    </style>

    @*  Ряд для кода  *@
    <div class="row">
        <div class="col col_margin border border-5 border-primary rounded rounded-5 w-auto">
            @* Заголовок админки *@
            <div class="admin_header">
                <h2>Создать статью</h2>
                <label for="inputArticle" class="form-label">Название статьи</label>
                <input type="text" class="form-control w-25" id="inputArticle" placeholder="name@example.com">
            </div>

            @*Тело редактор админки*@
            <div class="summernote">
                <textarea id="summernoteDescr"></textarea>
            </div>

            <div class="admin-footer">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault">
                    <label class="form-check-label" for="flexCheckDefault">
                        Автоматически добавлять тэги в статью
                    </label>
                </div>
            </div>
        </div>
    </div>

    @*Скрипты для админки*@
    <script>
        $(document).ready(function () {
            fnStartSummernote('summernoteDescr');
        });
    </script>
}
